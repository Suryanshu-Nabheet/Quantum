# Quantum monorepo — https://editorconfig.org
# Product trees may extend (see ide/.editorconfig for IDE-specific rules).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[agent/**]
indent_style = space
indent_size = 2

[ide/**]
indent_style = tab

[web/**]
indent_style = space
indent_size = 2

[{package.json,*.yml,*.yaml,*.md}]
indent_style = space
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab
