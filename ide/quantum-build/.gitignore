# =============================================================================
# Quantum build repo — .gitignore
#
# KEEP IN GIT (do not add rules that block these):
#   assets/Quantum.png / Quantum-dark.png — light/dark transparent marks
#   assets/app-icon.png / app-icon-light.png — white/black app marks
#   assets/lockup-*.png / sessions-*.svg / vscode-icon.svg — lockups + UI SVGs
#   icons/stable|insider/*.svg    — embedded branding SVGs
#   docs/img/quantum.png          — README / docs
#   src/stable|insider/resources/ — code.ico, BMPs, linux/code.png, etc.
#   patches/, build/windows/msi/quantum.wxs, docker/, .github/
#
# NEVER use a broad "Quantum*" pattern — it ignores icons/source/quantum-logo.png
# on case-insensitive filesystems (macOS).
# =============================================================================

# --- Cloned VS Code tree (get_repo.sh) and gulp output dirs ---
/vscode/
vscode/
vscode-*/
vscode*
VS*/*
VSCode/
VSCode-*/
VSCode*

# --- OS ---
.DS_Store
Thumbs.db
*.swp
*~

# --- Secrets ---
*.env
!*.env.template
!*.env.example
dev/osx/codesign.env

# --- Downloaded / generated during build ---
/sourcemaps/
/openssl/
/vscode-cli/
/pkg2appimage*/

# --- Build outputs in assets/ (release binaries, src archives, checksums, buildinfo) ---
# Keep branding masters; everything else here is generated by
# prepare_assets.sh / prepare_src.sh / prepare_checksums.sh and must not be committed.
/assets/*
!/assets/Quantum.png
!/assets/Quantum-dark.png
!/assets/app-icon.png
!/assets/app-icon-light.png
!/assets/lockup-light.png
!/assets/lockup-dark.png
!/assets/lockup-horizontal-light.png
!/assets/lockup-horizontal-dark.png
!/assets/lockup-banner-light.png
!/assets/lockup-banner-dark.png
!/assets/banner-lockup-light.png
!/assets/banner-lockup-dark.png
!/assets/Quantum_Name.png
!/assets/sessions-logo-light.svg
!/assets/sessions-logo-dark.svg
!/assets/sessions-icon.svg
!/assets/vscode-icon.svg
!/assets/readme-banner.png
!/assets/demo.png
# Wordmark fonts are fetched on demand by icons/generate_lockups.sh (not committed)
# README banner lives at repo-root assets/readme-banner.png only

# --- Linux AppImage ---
/build/linux/appimage/out/
/build/linux/appimage/pkg2appimage.AppDir
/build/linux/appimage/pkg2appimage-*.AppImage
/build/linux/appimage/pkg2appimage.AppImage
/build/linux/appimage/squashfs-root
/build/linux/appimage/Quantum
/build/linux/appimage/Quantum-*

# --- Windows MSI (generated WiX fragments) ---
/build/windows/msi/releasedir/
/build/windows/msi/Files*.wxs
/build/windows/msi/Files*.wixobj

# --- Snap outputs ---
/stores/snapcraft/insider/*.snap
/stores/snapcraft/stable/*.snap

# --- Icon script cache (regenerate: ./icons/generate_quantum_assets.sh) ---
/icons/.build/
.iconset/
**/code.iconset/

# --- Local backup bundles ---
*.bundle

# --- font-size subproject ---
/font-size/node_modules/
/font-size/lib/
/font-size/generate-css.js

# --- Optional root node_modules ---
/node_modules/

# Wordmark fonts fetched on demand by icons/generate_lockups.sh
/assets/fonts/
