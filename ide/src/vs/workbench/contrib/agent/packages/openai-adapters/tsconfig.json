{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmitOnError": false,
    "types": ["node"],
    "outDir": "../../../../../../../out/agent-packages/openai-adapters",
    "rootDir": "src",
    "declaration": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.vitest.ts",
    "src/test/**/*"
  ]
}
