{
  "name": "agent",
  "author": "Suryanshu Nabheet",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Suryanshu-Nabheet/Quantum.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "esbuild-base": "node scripts/esbuild.js",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "esbuild:visualize": "esbuild-visualizer --metadata ../../../../../out/agent/meta/esbuild.json --filename ../../../../../out/agent/meta/stats.html --open",
    "tsc": "tsc -p ./",
    "tsc:check": "tsc -p ./ --noEmit",
    "test": "npm --prefix core run vitest",
    "eval:harness": "npm run eval:harness --prefix gui",
    "verify": "npm run tsc:check && npm test && node scripts/verify-packages.js",
    "build:webview": "npm run build --prefix gui && node scripts/ensure-webview.js",
    "build:agent": "node scripts/build-packages.js && npm run build:webview && npm run esbuild-base -- --minify",
    "predev": "node scripts/ensure-webview.js",
    "dev": "concurrently -n gui,host,core,esbuild -c cyan,magenta,yellow,blue \"npm run dev --prefix gui\" \"npm run tsc:watch:host\" \"npm run tsc:watch:core\" \"npm run esbuild-watch\"",
    "tsc:watch": "concurrently -n gui,host,core -c cyan,magenta,yellow \"npm run tsc:watch:gui\" \"npm run tsc:watch:host\" \"npm run tsc:watch:core\"",
    "tsc:watch:gui": "tsc --project gui/tsconfig.json --watch --noEmit --pretty",
    "tsc:watch:host": "tsc -p ./ --watch --noEmit --pretty",
    "tsc:watch:core": "tsc --project core/tsconfig.json --watch --noEmit --pretty",
    "clean": "node scripts/clean-artifacts.js"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "concurrently": "^9.1.2",
    "esbuild": "0.17.19",
    "esbuild-visualizer": "^0.6.0",
    "eslint": "^8",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.5",
    "typescript": "^5.6.3",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "core": "file:./core",
    "fetch": "file:./packages/fetch",
    "minisearch": "^7.0.0",
    "uuid": "^9.0.1"
  },
  "overrides": {
    "vitest": {
      "@types/node": "^16.18.119"
    }
  }
}
