{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2022",
		"outDir": "out",
		"lib": [
			"ES2022",
			"DOM"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": [
			"node"
		],
		"typeRoots": [
			"../../node_modules/@types",
			"../../src/vscode-dts",
			"node_modules/@types"
		]
	},
	"include": [
		"src/**/*.ts",
		"../../src/vscode-dts/vscode.d.ts"
	],
	"exclude": [
		"node_modules",
		".vscode-test",
		"src/test"
	]
}
