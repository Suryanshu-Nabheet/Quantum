{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "dom",
      "es6",
      "es5",
      "dom.iterable",
      "scripthost"
    ],
    "outDir": "out/tsc/src",
    "sourceMap": true,
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "core/**/*.ts",
    "core/**/*.d.ts",
    "workbench/runtime/**/*.ts"
  ],
  "exclude": [
    "core/dist/**/*",
    "core/**/*.vitest.ts",
    "core/**/test/**/*",
    "core/**/*.skip.ts"
  ]
}
