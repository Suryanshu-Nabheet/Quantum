{
  "name": "@quantum/root",
  "version": "0.0.0",
  "private": true,
  "description": "Quantum monorepo orchestration — product installs and builds remain in ide/ (npm) and agent/ (Bun).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Suryanshu-Nabheet/Quantum.git"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "verify": "bash scripts/verify.sh",
    "verify:repo": "bash scripts/verify-repo-config.sh",
    "e2e": "bash scripts/e2e.sh",
    "mise:install": "mise install",
    "build:agent": "bun run --cwd agent build",
    "build:agent:desktop": "bun run --cwd agent build:desktop",
    "dev:agent": "bun run --cwd agent dev",
    "typecheck:agent": "bun run --cwd agent typecheck",
    "test:agent": "bun run --cwd agent test",
    "compile:ide": "npm run compile --prefix ide",
    "compile:ide:agent": "npm run compile-agent --prefix ide",
    "doctor": "bash scripts/monorepo-doctor.sh",
    "doctor:strict": "bash scripts/monorepo-doctor.sh --strict"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
